# Local database and timezone
DATABASE_PATH=./data/tg.sqlite
TZ=America/Chicago

# Chat model. Any OpenAI-compatible endpoint works.
# Leave AI_API_KEY empty to run without AI and use the deterministic engine.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional: Jev picks the best of four AI candidates.
# Leave TYPESAFE_API_KEY empty to use the deterministic audit instead.
# TYPESAFE_API_KEY=
# AI_DECIDER=auto
# AI_CANDIDATES=4

# Docker only: host folder for the database.
# TG_DATA_PATH=./data
